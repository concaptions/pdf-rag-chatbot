# Server-side only. Never expose these to the frontend.
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5-5
# Fallback provider (used automatically if the primary fails)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4.1
# Which provider to try first: anthropic or openai
LLM_PRIMARY=anthropic
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Comma-separated list of allowed frontend origins (CORS)
ALLOWED_ORIGINS=http://localhost:5173
# Optional tuning
TOP_K=6
MIN_SIMILARITY=0.45
MAX_UPLOAD_MB=25
